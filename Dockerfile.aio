# Stars Organizer all-in-one: Postgres, Electric and Stars Organizer in ONE container, for platforms that
# install one container per app (Unraid Community Apps) and for anyone who wants `docker run` and nothing
# else. Everything it keeps is under /data: mount that one path and back it up.
#
#   docker run -d -p 8080:8080 -v stars-data:/data -e GITHUB_TOKEN=ghp_... ghcr.io/armanckeser/github-stars-organizer:aio
#
# s6-overlay supervises the three processes (aio/s6-rc.d). Built from the app image of the same version
# (APP_IMAGE). That image is Alpine, while Electric's release needs glibc, so Node comes from the Debian
# image and only Stars Organizer's JavaScript (server, web build, node_modules) comes from APP_IMAGE.

ARG APP_IMAGE
FROM electricsql/electric:1.7.6 AS electric
FROM node:24-bookworm-slim AS node
FROM ${APP_IMAGE} AS app

FROM postgres:16-bookworm
ARG TARGETARCH
ARG S6_OVERLAY_VERSION=3.2.1.0

RUN apt-get update \
 && apt-get install -y --no-install-recommends xz-utils ca-certificates openssl locales \
 && sed -i 's/# en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen && locale-gen \
 && rm -rf /var/lib/apt/lists/*

ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz /tmp/
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-x86_64.tar.xz /tmp/
ADD https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-aarch64.tar.xz /tmp/
RUN tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz \
 && tar -C / -Jxpf "/tmp/s6-overlay-$([ "$TARGETARCH" = "arm64" ] && echo aarch64 || echo x86_64).tar.xz" \
 && rm /tmp/s6-overlay-*.tar.xz

COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN useradd --create-home --uid 1000 app
COPY --from=app --chown=app:app /app /app
COPY --from=electric /app /opt/electric

COPY aio/s6-rc.d /etc/s6-overlay/s6-rc.d
COPY aio/scripts /etc/s6-overlay/scripts
# A checkout on Windows can carry CRLF line endings and no executable bit; s6 needs both right.
RUN find /etc/s6-overlay/s6-rc.d /etc/s6-overlay/scripts -type f -exec sed -i 's/\r$//' {} + \
 && chmod +x /etc/s6-overlay/scripts/* /etc/s6-overlay/s6-rc.d/*/run

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    WEB_ROOT=dist \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0 \
    S6_BEHAVIOUR_IF_STAGE2_FAILS=2

VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s \
  CMD node -e "fetch('http://127.0.0.1:8080/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
ENTRYPOINT ["/init"]
