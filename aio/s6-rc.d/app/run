#!/command/with-contenv sh
PASSWORD="$(cat /data/secrets/postgres-password)"
export DATABASE_URL="postgresql://postgres:${PASSWORD}@127.0.0.1:5432/app"
export ELECTRIC_URL=http://127.0.0.1:3000
export ELECTRIC_SECRET="$(cat /data/secrets/electric-secret)"
export HOME=/data/home
cd /app
exec s6-setuidgid app node server/boot.ts
