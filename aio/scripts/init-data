#!/command/with-contenv sh
# First boot of the all-in-one image: lay out /data (the one volume) and create the Postgres cluster.
# Every later boot finds both and does nothing. The database password and Electric's secret are generated
# here, once, and never leave /data/secrets.
set -eu
mkdir -p /data/postgres /data/electric /data/secrets /data/home

if [ ! -s /data/secrets/postgres-password ]; then
  openssl rand -hex 24 > /data/secrets/postgres-password
fi
if [ ! -s /data/secrets/electric-secret ]; then
  openssl rand -hex 24 > /data/secrets/electric-secret
fi
chown -R app:app /data/electric /data/home
chown root:app /data/secrets /data/secrets/*
chmod 750 /data/secrets
chmod 640 /data/secrets/*
chown -R postgres:postgres /data/postgres
chmod 700 /data/postgres

if [ ! -s /data/postgres/PG_VERSION ]; then
  echo "Creating the database (first start)..."
  cp /data/secrets/postgres-password /tmp/pwfile && chown postgres /tmp/pwfile
  s6-setuidgid postgres initdb -D /data/postgres -U postgres --pwfile=/tmp/pwfile \
    --auth-local=peer --auth-host=scram-sha-256 --encoding=UTF8 >/dev/null
  rm -f /tmp/pwfile
fi
