#!/command/with-contenv sh
# Wait for Postgres, then make sure the app database exists (the cluster starts with only `postgres`).
set -eu
until pg_isready -h 127.0.0.1 -U postgres -q; do sleep 1; done
s6-setuidgid postgres psql -h /var/run/postgresql -U postgres -tAc "SELECT 1 FROM pg_database WHERE datname = 'app'" | grep -q 1 \
  || s6-setuidgid postgres createdb -h /var/run/postgresql -U postgres app
